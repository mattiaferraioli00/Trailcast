ARG PHP_VERSION
ARG COMPOSER_VERSION

FROM composer:${COMPOSER_VERSION} AS composer-fixed-version

FROM php:${PHP_VERSION}-fpm

ARG TZ=Europe/Rome
ENV TZ ${TZ}

# Installa pacchetti di sistema necessari
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    sudo \
    unzip \
    libzip-dev \
    libicu-dev \
    libonig-dev \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    && rm -rf /var/lib/apt/lists/*

# Install PHP extensions
RUN docker-php-ext-install zip pdo_mysql mbstring exif pcntl bcmath gd intl opcache \
    && pecl install redis pcov\
    && docker-php-ext-enable redis pcov

# Set the timezone
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Get latest Composer
COPY --from=composer-fixed-version /usr/bin/composer /usr/bin/composer

# Install the Symfony CLI (provides the local web server)
RUN curl -sS https://get.symfony.com/cli/installer | bash \
    && mv /root/.symfony*/bin/symfony /usr/local/bin/symfony

ARG USER=appuser
ARG UID=1000

RUN useradd -G www-data -u $UID -d /home/$USER $USER
RUN mkdir -p /home/$USER/.composer && \
    chown -R $USER:$USER /home/$USER

RUN adduser $USER sudo
RUN echo '%sudo ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

# Set working directory
WORKDIR /var/www

COPY docker/docker-entrypoint.sh /usr/local/bin/
RUN ln -s /usr/local/bin/docker-entrypoint.sh /

RUN chown -R ${USER}:www-data /usr/local/etc/php/conf.d

RUN chmod +x /docker-entrypoint.sh

USER $USER

EXPOSE 8080
