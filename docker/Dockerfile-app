ARG PHP_VERSION
ARG COMPOSER_VERSION

FROM composer:${COMPOSER_VERSION} AS composer-fixed-version

FROM php:${PHP_VERSION}-fpm

ARG TZ=Europe/Rome
ENV TZ ${TZ}

# Installa pacchetti di sistema necessari
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    unzip \
    libzip-dev \
    libicu-dev \
    libonig-dev \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    && rm -rf /var/lib/apt/lists/*

# Install PHP extensions
RUN docker-php-ext-install zip pdo_mysql mbstring exif pcntl bcmath gd intl opcache \
    && pecl install redis \
    && docker-php-ext-enable redis

# Set the timezone
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Get latest Composer
COPY --from=composer-fixed-version /usr/bin/composer /usr/bin/composer

ARG USER_ID=1000
ARG GROUP_ID=1000
RUN groupadd -g $GROUP_ID appgroup \
    && useradd -u $USER_ID -g $GROUP_ID -m appuser

USER appuser
WORKDIR /app
